# Python environments and bytecode
.venv/
venv/
__pycache__/
*.py[cod]

# Test, type-checker, linter, and coverage caches
.pytest_cache/
.hypothesis/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
coverage.xml
htmlcov/

# Build and packaging output
build/
dist/
*.egg-info/

# Runtime state (keep authored JSON under content/ versioned)
saves/*
!saves/.gitkeep
backups/*
!backups/.gitkeep
exports/*
!exports/.gitkeep

# Canon database artifacts (keep authored extraction under data/canon/ versioned)
data/raw/*
!data/raw/.gitkeep
!data/raw/PROVENANCE.json
data/parsed/*
!data/parsed/.gitkeep
data/indexes/*
!data/indexes/.gitkeep
data/db/*
!data/db/.gitkeep

# Verification reports are generated; extraction candidates stay versioned
data/canon/*.report.json

# Local editor and operating-system files
.idea/
.vscode/
.DS_Store
Thumbs.db
